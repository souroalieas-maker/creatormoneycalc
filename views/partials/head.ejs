<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
  const pageTitle = (typeof seoTitle !== 'undefined' && seoTitle) ? seoTitle : site.seo_site_title;
  const pageDesc = (typeof seoDesc !== 'undefined' && seoDesc) ? seoDesc : site.seo_meta_description;
  const pageCanonical = (typeof canonical !== 'undefined' && canonical) ? canonical : null;
  const pageOgImage = ((typeof ogImage !== 'undefined' && ogImage) ? ogImage : site.og_image) || '';
%>
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDesc %>">
<% if (pageCanonical) { %><link rel="canonical" href="<%= pageCanonical %>"><% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= site.site_name %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDesc %>">
<% if (pageCanonical) { %><meta property="og:url" content="<%= pageCanonical %>"><% } %>
<% if (pageOgImage) { %><meta property="og:image" content="<%= pageOgImage %>"><% } %>
<meta name="twitter:card" content="<%= pageOgImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDesc %>">
<% if (site.google_verification) { %><meta name="google-site-verification" content="<%= site.google_verification %>"><% } %>
<% if (site.bing_verification) { %><meta name="msvalidate.01" content="<%= site.bing_verification %>"><% } %>
<% if (site.seo_keywords) { %><meta name="keywords" content="<%= site.seo_keywords %>"><% } %>
<link rel="icon" href="<%= site.favicon_url || '/assets/img/favicon.svg' %>" type="image/svg+xml">
<link rel="stylesheet" href="/assets/css/public.css">
<script src="/assets/js/nav.js" defer></script>
<% if (typeof schema !== 'undefined' && schema) { %>
<script type="application/ld+json"><%- JSON.stringify(schema).replace(/<\//g, '<\\/') %></script>
<% } %>
</head>
