<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="site-logo" href="/" aria-label="<%= site.site_name %> — home"><% if (site.logo_url) { %><img src="<%= site.logo_url %>" alt="<%= site.site_name %>" class="site-logo-img"><% } else { %><%- helpers.escapeHtml(site.site_name).replace('MoneyCalc', '<span>MoneyCalc</span>') %><% } %></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation">&#9776;</button>
    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul>
        <li><a href="/">Home</a></li>
        <li class="has-dropdown">
          <a href="/calculators" aria-haspopup="true">Calculators</a>
          <ul class="dropdown">
            <% calcNav.forEach(function(item){ %>
            <li><a href="<%= item.path %>"><%= calcs[item.key].title %></a></li>
            <% }) %>
          </ul>
        </li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/tools">YouTube Tools</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>
  </div>
</header>
<div class="container"><%- include('ad', { location: 'header' }) %></div>
