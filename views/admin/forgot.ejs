<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forgot Password · CreatorMoneyCalc</title>
<link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <h1>Forgot Password</h1>
    <p class="sub">Enter your admin email and the recovery code shown when your account was created.</p>
    <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/admin/forgot">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= email %>" required autocomplete="username">
      </div>
      <div class="form-group">
        <label for="recovery_code">Recovery Code</label>
        <input type="text" id="recovery_code" name="recovery_code" required autocomplete="off" placeholder="XXXX-XXXX-XXXX">
      </div>
      <button class="abtn" type="submit">Verify</button>
    </form>
    <p style="margin-top:16px;font-size:.9rem"><a href="/admin/login">Back to login</a></p>
  </div>
</div>
</body>
</html>
