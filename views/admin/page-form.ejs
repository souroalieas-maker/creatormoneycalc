<% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
<form method="post" action="/admin/pages/<%= page.slug %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="panel">
    <div class="form-group">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= page.title %>" maxlength="200" required>
    </div>
    <div class="form-group">
      <label for="body_md">Content (Markdown)</label>
      <textarea id="body_md" name="body_md" style="min-height:380px"><%= page.body_md %></textarea>
      <div class="md-preview" id="md-preview" aria-label="Live preview"></div>
    </div>
  </div>
  <button class="abtn" type="submit">Save Changes</button>
  <a class="abtn abtn-secondary" href="/admin/pages">Cancel</a>
</form>
