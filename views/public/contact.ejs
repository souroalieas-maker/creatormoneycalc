<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container">
  <h1 class="section-title"><%= pageTitle %></h1>
  <% if (pageBody) { %><div class="post-body"><%- pageBody %></div><% } %>

  <% if (success) { %>
    <div class="disclaimer-box">
      <strong>Thank you &mdash; your message has been received.</strong>
      It is stored for our team to review, and we will get back to you if needed.
    </div>
    <p><a href="/">Back to the homepage</a></p>
  <% } else { %>
    <% if (errors && errors.length) { %>
      <div class="calc-error show" role="alert">
        <ul>
          <% errors.forEach(function(e){ %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>
    <form method="post" action="/contact" class="calc-card" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="contact-name">Name</label>
        <input type="text" id="contact-name" name="name" value="<%= values.name %>" required autocomplete="name">
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input type="email" id="contact-email" name="email" inputmode="email" value="<%= values.email %>" required autocomplete="email">
      </div>
      <div class="field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" rows="6" required><%= values.message %></textarea>
      </div>
      <button class="btn" type="submit">Send Message</button>
      <p class="muted">Your message is stored for our team to review.</p>
    </form>
    <% if (site.contact_email) { %>
    <p class="muted">Prefer email? Reach us at <a href="mailto:<%= site.contact_email %>"><%= site.contact_email %></a>.</p>
    <% } %>
  <% } %>
</main>
<%- include('../partials/footer') %>
