<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="container">
  <h1 class="section-title">Blog</h1>
  <p class="muted">Guides on YouTube RPM, monetization, Shorts earnings and growing your creator revenue.</p>
  <% if (posts && posts.length) { %>
  <div class="cards-grid">
    <% posts.forEach(function(p){ %>
    <article class="card">
      <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
      <% if (p.category) { %><p class="muted"><%= p.category %></p><% } %>
      <% if (p.meta_description) { %><p><%= p.meta_description %></p><% } %>
      <a class="btn btn-secondary" href="/blog/<%= p.slug %>">Read article</a>
    </article>
    <% }) %>
  </div>
  <% } else { %>
  <p>No articles yet &mdash; check back soon.</p>
  <% } %>
</main>
<%- include('../partials/footer') %>
